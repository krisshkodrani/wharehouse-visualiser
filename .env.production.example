# Template for /opt/whv/.env on the Lightsail instance. Copy, fill in, chmod 600.
# Never commit the filled-in version — .gitignore covers .env and .env.* already.
#
# Compose reads this automatically from the directory it runs in. Anything marked
# required uses ${VAR:?...} in compose.prod.yaml, so a missing value fails the deploy
# instead of surfacing later as a runtime error.

# --- Release ------------------------------------------------------------------
# The published tag to run. Changing this line and re-running `pull` + `up -d` is
# both how you deploy and how you roll back, which is why it is not `latest`.
IMAGE_TAG=v0.2.0

# --- Secrets generated on the instance ----------------------------------------
# These are used nowhere outside this box, so generate them here and let them exist
# nowhere else:
#   openssl rand -base64 24
#
# POSTGRES_PASSWORD is read by the postgres image ONLY when the data directory is
# empty. Set it correctly on the very first boot; changing it later does not change
# the running database and will lock the backend out until the volume is wiped.
POSTGRES_PASSWORD=
# Written into the broker's own password file and used by the backend and simulator
# to connect. All three come from this one variable, so they cannot drift apart.
MQTT_PASSWORD=

# --- Secret you hand-carry ----------------------------------------------------
# The only value that has to travel to the instance. Write it with an editor —
# `echo "sk-or-..." >> .env` would land in ~/.bash_history.
# Set a hard spending cap on the OpenRouter account: with an open endpoint that cap
# is the only control that cannot be bypassed from outside the box.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional hard provider pin. Fallbacks are disabled when this is set.
OPENROUTER_PROVIDER=
OPENROUTER_TIMEOUT_SECONDS=60

# Escape hatch: set AI_PROVIDER=mock and restart the backend to take LLM spend to
# zero without touching anything else. The demo still works — the validation path
# runs identically against a deterministic nearest-slot stand-in.

# --- Optional overrides -------------------------------------------------------
# Usernames default to `warehouse` in compose.prod.yaml; override only if you care.
# POSTGRES_USER=warehouse
# MQTT_USER=warehouse

# Simulator tuning. Defaults match .env.example.
# AGV_SPEED=2.5
# AGV_LOADED_SPEED=1.8
# AGV_DOCKING_SPEED=0.7
# AGV_ACCELERATION=1.0
# AGV_BRAKING=1.5
# AGV_BATTERY_CONSUMPTION_PER_METRE=0.015
