FROM maven:3.9.15-eclipse-temurin-26 AS build
WORKDIR /workspace
COPY pom.xml ./
COPY vda5050-contracts/pom.xml vda5050-contracts/pom.xml
COPY backend/pom.xml backend/pom.xml
COPY simulator/pom.xml simulator/pom.xml
COPY vda5050-contracts/src vda5050-contracts/src
COPY simulator/src simulator/src
RUN mvn -B -pl simulator -am package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/simulator/target/warehouse-simulator-*.jar app.jar
ENTRYPOINT ["java","-jar","app.jar"]
