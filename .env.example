# The deterministic provider is the default and requires no network access.
AI_PROVIDER=mock

# Enable OpenRouter with AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional hard provider pin. Fallbacks are disabled when this is set.
OPENROUTER_PROVIDER=
OPENROUTER_TIMEOUT_SECONDS=60

# Higher values make the simulated AGV complete routes faster.
AGV_SPEED=2.5
AGV_LOADED_SPEED=1.8
AGV_DOCKING_SPEED=0.7
AGV_ACCELERATION=1.0
AGV_BRAKING=1.5
# Percentage points consumed per metre (0.015 gives about 6.7 km from 100%).
AGV_BATTERY_CONSUMPTION_PER_METRE=0.015
POSTGRES_VOLUME_NAME=warehouse-visualizer_warehouse-postgres17
