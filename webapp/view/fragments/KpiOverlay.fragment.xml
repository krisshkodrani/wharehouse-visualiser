<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <HBox class="operationsSummary" visible="{= ${warehouse>/viewMode} === 'OPERATIONS' }" alignItems="Center">
    <Text text="OPERATIONS" class="sectionEyebrow" />
    <VBox class="operationsKpi"><ObjectNumber number="{warehouse>/queuedOrderCount}" /><Text text="Queued" /></VBox>
    <VBox class="operationsKpi"><ObjectNumber number="{warehouse>/oldestQueuedLabel}" state="{warehouse>/oldestQueuedState}" /><Text text="Longest wait" /></VBox>
    <VBox class="operationsKpi"><ObjectNumber number="{warehouse>/completedPerMinute}" unit="/min" state="Information" /><Text text="Throughput" /></VBox>
    <VBox class="operationsKpi kpiActionable" tooltip="Show only orders needing attention">
      <ObjectNumber number="{warehouse>/attentionCount}" state="{= ${warehouse>/attentionCount} > 0 ? 'Error' : 'None' }" />
      <Link text="Attention" press=".onShowAttention" enabled="{= ${warehouse>/attentionCount} > 0 }" />
    </VBox>
    <ObjectStatus text="{warehouse>/activityText}" icon="sap-icon://activity-items" state="Information" class="operationsNow" />
  </HBox>
</core:FragmentDefinition>
