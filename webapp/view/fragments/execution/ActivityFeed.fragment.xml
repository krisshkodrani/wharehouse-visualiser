<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <VBox class="activitySection">
    <VBox class="sectionHeading"><Title text="Exceptions" level="H3" /><Text text="Problems that may require operator action" /></VBox>
    <List items="{warehouse>/visibleInspectionActivity}" noDataText="No exceptions for this order" showSeparators="None" class="activityFeed">
      <CustomListItem>
        <HBox class="activityItem" alignItems="Start">
          <core:Icon src="{warehouse>icon}" color="{= ${warehouse>state} === 'Error' ? '#bb0000' : ${warehouse>state} === 'Success' ? '#188918' : '#0a6ed1' }" />
          <VBox><HBox justifyContent="SpaceBetween"><Text text="{warehouse>title}" class="activityTitle" /><Text text="{warehouse>timeLabel}" class="activityTime" /></HBox><Text text="{warehouse>description}" wrapping="true" /></VBox>
        </HBox>
      </CustomListItem>
    </List>
  </VBox>
</core:FragmentDefinition>
