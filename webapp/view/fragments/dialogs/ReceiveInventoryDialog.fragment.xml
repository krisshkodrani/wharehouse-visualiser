<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="receiveDialog" title="Receive inventory" contentWidth="28rem" stretchOnPhone="true">
    <VBox class="dialogForm">
      <Label text="Material / SKU" labelFor="receiveSku" /><Input id="receiveSku" value="{warehouse>/receiveSku}" />
      <Label text="Quantity" labelFor="receiveQuantity" /><StepInput id="receiveQuantity" value="{warehouse>/receiveQuantity}" min="1" max="50" width="100%" />
      <MessageStrip text="Received loads enter INBOUND-01 and become eligible for a put-away transport order." type="Information" showIcon="true" />
    </VBox>
    <beginButton><Button text="Receive inventory" type="Emphasized" press=".onReceiveFromDialog" /></beginButton>
    <endButton><Button text="Cancel" press=".onCloseReceive" /></endButton>
  </Dialog>
</core:FragmentDefinition>
