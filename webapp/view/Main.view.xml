<mvc:View controllerName="warehouse.visualizer.controller.Main" displayBlock="true"
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:warehouse="warehouse.visualizer.control" xmlns:code="sap.ui.codeeditor">
  <Page showHeader="false" enableScrolling="false" class="warehousePage controlTowerPage">
    <VBox height="100%" renderType="Bare">
      <OverflowToolbar class="controlTowerHeader">
        <Avatar displayShape="Square" initials="W" backgroundColor="Accent6" />
        <VBox class="towerBrand">
          <Title text="Warehouse Control Tower" level="H1" />
          <Text text="{= ${warehouse>/warehouseName} + ' · ' + (${warehouse>/scenario/name} || 'Choose scenario') }" />
        </VBox>
        <ToolbarSpacer />
        <ObjectStatus text="{warehouse>/connectionStatus}" icon="sap-icon://connected"
          state="{= ${warehouse>/connectionStatus} === 'CONNECTED' ? 'Success' : 'Warning' }" />
        <ObjectStatus title="Vehicle" text="{= ${warehouse>/agv/id} + ' · ' + ${warehouse>/agv/status} }" icon="sap-icon://shipping-status"
          state="{= ${warehouse>/agv/status} === 'MOVING' ? 'Information' : 'Success' }" />
        <ProgressIndicator width="6rem" percentValue="{warehouse>/agv/battery}" displayValue="{= Math.round(${warehouse>/agv/battery}) + '%' }" state="Success" />
        <Button text="Receive inventory" icon="sap-icon://add-product" press=".onOpenReceive" />
        <Button text="{= ${warehouse>/operationState} === 'PAUSED' ? 'Resume fleet' : 'Pause fleet' }"
          icon="{= ${warehouse>/operationState} === 'PAUSED' ? 'sap-icon://media-play' : 'sap-icon://media-pause' }" press=".onToggleOperations" />
        <MenuButton text="Demo tools" icon="sap-icon://activate">
          <menu><Menu itemSelected=".onDemoMenuItem"><items>
            <MenuItem text="Inject VDA rejection" key="reject" icon="sap-icon://error" />
            <MenuItem text="Block selected route" key="block" icon="sap-icon://road" />
          </items></Menu></menu>
        </MenuButton>
        <Button text="New transport order" icon="sap-icon://add" type="Emphasized" press=".onOpenTransportOrder" />
      </OverflowToolbar>

      <HBox fitContainer="true" renderType="Bare" class="towerWorkspace">
        <VBox width="19rem" renderType="Bare" class="orderRail">
          <HBox justifyContent="SpaceBetween" alignItems="Center" class="railHeading">
            <VBox><Title text="Transport orders" level="H2" /><Text text="Business intent and execution" /></VBox>
            <ObjectNumber number="{= ${warehouse>/transportOrders}.length }" unit="total" />
          </HBox>
          <HBox class="orderMetrics">
            <VBox><ObjectNumber number="{warehouse>/activeOrderCount}" state="Information" /><Text text="Active" /></VBox>
            <VBox><ObjectNumber number="{warehouse>/queuedOrderCount}" /><Text text="Queued" /></VBox>
            <VBox><ObjectNumber number="{warehouse>/attentionCount}" state="Error" /><Text text="Attention" /></VBox>
          </HBox>
          <List id="transportOrderList" items="{warehouse>/transportOrders}" itemPress=".onOrderPress" noDataText="No transport orders yet" showSeparators="None" class="transportOrderList">
            <CustomListItem type="Active">
              <VBox class="orderCard">
                <HBox justifyContent="SpaceBetween" alignItems="Center">
                  <Title text="{= 'TO-' + ${warehouse>shortId} }" level="H4" />
                  <ObjectStatus text="{warehouse>status}" state="{= ${warehouse>status} === 'COMPLETED' ? 'Success' : ${warehouse>status} === 'FAILED' ? 'Error' : ${warehouse>status} === 'IN_PROGRESS' ? 'Information' : 'None' }" inverted="true" />
                </HBox>
                <Text text="{= ${warehouse>displayType} + ' · ' + ${warehouse>priority} }" class="orderType" />
                <HBox justifyContent="SpaceBetween"><Text text="{= ${warehouse>tasks}.length + ' load task(s)' }" /><Text text="{warehouse>assignedAgv}" /></HBox>
                <ProgressIndicator percentValue="{warehouse>progress}" displayValue="{= ${warehouse>completedTasks} + ' / ' + ${warehouse>tasks}.length }" state="Information" />
              </VBox>
            </CustomListItem>
          </List>
          <VBox class="railFooter">
            <Button text="Reset scenario" icon="sap-icon://refresh" type="Transparent" press=".onResetSimulation" />
            <HBox alignItems="Center" justifyContent="SpaceBetween">
              <Label text="Simulation speed" labelFor="speedSelector" />
              <SegmentedButton id="speedSelector" selectedKey="{warehouse>/timeScale}" selectionChange=".onSpeedChange">
                <items><SegmentedButtonItem key="1" text="1x" /><SegmentedButtonItem key="2" text="2x" /><SegmentedButtonItem key="4" text="4x" /></items>
              </SegmentedButton>
            </HBox>
          </VBox>
        </VBox>

        <VBox renderType="Bare" class="mapStage">
          <HBox class="mapOverlay" justifyContent="SpaceBetween" alignItems="Start">
            <VBox class="floatingCard"><Title text="Live warehouse" level="H3" /><Text text="{= ${warehouse>/selectedOrder/shortId} ? 'Selected TO-' + ${warehouse>/selectedOrder/shortId} : 'Select an order to inspect its route' }" /></VBox>
            <HBox class="mapKpis">
              <VBox class="floatingCard compactKpi"><ObjectNumber number="1" unit="/ 1" /><Text text="AGVs online" /></VBox>
              <VBox class="floatingCard compactKpi"><ObjectNumber number="{warehouse>/queuedOrderCount}" /><Text text="Queued" /></VBox>
              <VBox class="floatingCard compactKpi"><ObjectNumber number="{warehouse>/attentionCount}" state="Error" /><Text text="Attention" /></VBox>
            </HBox>
          </HBox>
          <warehouse:WarehouseViewport id="viewport" rackSelected=".onRackSelected" class="warehouseViewport" />
          <HBox class="routeLegend"><Text text="━ Released base" /><Text text="┅ Horizon" /></HBox>
        </VBox>

        <VBox width="27rem" renderType="Bare" class="orderDetail executionPanel">
          <VBox class="detailHeader executionHeader">
            <HBox justifyContent="SpaceBetween" alignItems="Start">
              <VBox>
                <Text text="TRANSPORT ORDER" class="sectionEyebrow" />
                <Title text="{= ${warehouse>/selectedOrder/shortId} ? 'TO-' + ${warehouse>/selectedOrder/shortId} : 'No order selected' }" level="H2" />
                <Text text="{= ${warehouse>/selectedOrder/type} ? (${warehouse>/selectedOrder/type} === 'PUTAWAY' ? 'Put-away' : 'Outbound') + ' · ' + ${warehouse>/selectedOrder/priority} + ' priority' : 'Choose or create a transport order' }" />
              </VBox>
              <ObjectStatus text="{warehouse>/selectedOrder/status}" state="{= ${warehouse>/selectedOrder/status} === 'COMPLETED' ? 'Success' : ${warehouse>/selectedOrder/status} === 'FAILED' ? 'Error' : 'Information' }" inverted="true" />
            </HBox>
            <ProgressIndicator percentValue="{warehouse>/inspection/progress}" displayValue="{= ${warehouse>/inspection/completedTasks} + ' of ' + ${warehouse>/inspection/tasks}.length + ' tasks' }" state="Information" />
            <HBox class="executionFacts" justifyContent="SpaceBetween">
              <VBox><Label text="Assigned AGV" /><Text text="{warehouse>/inspection/assignedAgv}" /></VBox>
              <VBox><Label text="VDA updates" /><ObjectNumber number="{warehouse>/inspection/protocolUpdateCount}" /></VBox>
              <VBox><Label text="Schema" /><ObjectStatus text="3.0.0" state="Success" /></VBox>
            </HBox>
            <HBox class="executionActions" justifyContent="SpaceBetween">
              <Button text="Inspect VDA 5050" icon="sap-icon://source-code" type="Emphasized" press=".onOpenVdaInspector"
                enabled="{= ${warehouse>/inspection/protocolUpdateCount} > 0 }" />
              <Button text="Cancel" icon="sap-icon://decline" type="Transparent" press=".onCancelSelectedOrder"
                enabled="{= !!${warehouse>/selectedOrder/id} &amp;&amp; ${warehouse>/selectedOrder/status} !== 'COMPLETED' &amp;&amp; ${warehouse>/selectedOrder/status} !== 'CANCELLED' }" />
            </HBox>
          </VBox>
          <ScrollContainer vertical="true" horizontal="false" height="100%" class="executionScroll">
            <VBox class="executionContent">
              <VBox class="intentCard">
                <Text text="BUSINESS INTENT" class="sectionEyebrow" />
                <Text text="{= ${warehouse>/selectedOrder/objective} || 'Select a transport order to inspect execution.' }" class="intentText" />
              </VBox>

              <HBox justifyContent="SpaceBetween" alignItems="Center" class="sectionHeading">
                <VBox><Title text="Execution journey" level="H3" /><Text text="One load movement per task" /></VBox>
                <ObjectNumber number="{= ${warehouse>/inspection/tasks}.length }" unit="tasks" />
              </HBox>
              <List items="{warehouse>/inspection/tasks}" itemPress=".onTaskPress" noDataText="No tasks generated yet" showSeparators="None" class="taskJourney">
                <CustomListItem type="Active" selected="{warehouse>selected}">
                  <VBox class="taskJourneyItem">
                    <HBox justifyContent="SpaceBetween" alignItems="Start">
                      <HBox alignItems="Start" class="taskIdentity">
                        <Avatar displayShape="Circle" displaySize="XS" initials="{warehouse>sequence}" backgroundColor="Accent6" />
                        <VBox><Text text="{warehouse>label}" class="taskLabel" /><Title text="{warehouse>loadId}" level="H4" /><Text text="{warehouse>routeLabel}" /></VBox>
                      </HBox>
                      <ObjectStatus text="{warehouse>status}" state="{warehouse>statusState}" inverted="true" />
                    </HBox>
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="taskMeta">
                      <HBox alignItems="Center" class="taskVehicle"><core:Icon src="sap-icon://shipping-status" /><Text text="{warehouse>vehicleLabel}" /></HBox>
                      <Button text="{= ${warehouse>updateCount} + ' VDA update' + (${warehouse>updateCount} === 1 ? '' : 's') }" icon="sap-icon://source-code"
                        type="Transparent" press=".onInspectTaskVda" enabled="{= ${warehouse>updateCount} > 0 }" />
                    </HBox>
                    <VBox visible="{warehouse>selected}" class="taskExpanded">
                      <Label text="Planned route" /><Text text="{warehouse>routeText}" wrapping="true" />
                      <HBox wrap="Wrap" class="taskTimes">
                        <ObjectStatus title="Accepted" text="{warehouse>acceptedLabel}" icon="sap-icon://accept" />
                        <ObjectStatus title="Started" text="{warehouse>startedLabel}" icon="sap-icon://process" />
                        <ObjectStatus title="Completed" text="{warehouse>completedLabel}" icon="sap-icon://complete" />
                      </HBox>
                    </VBox>
                  </VBox>
                </CustomListItem>
              </List>

              <VBox class="protocolHealthCard">
                <HBox justifyContent="SpaceBetween" alignItems="Center">
                  <VBox><Text text="PROTOCOL HEALTH" class="sectionEyebrow" /><Title text="VDA 5050 exchange" level="H4" /></VBox>
                  <ObjectStatus text="{warehouse>/inspection/protocolHealthLabel}" state="{warehouse>/inspection/protocolHealthState}" icon="sap-icon://sys-enter-2" />
                </HBox>
                <Text text="Business tasks are grouped with every published base update, validation result, and wire payload." />
                <Button text="Open protocol workbench" icon="sap-icon://inspect" type="Transparent" press=".onOpenVdaInspector"
                  enabled="{= ${warehouse>/inspection/protocolUpdateCount} > 0 }" />
              </VBox>

              <VBox class="activitySection">
                <VBox class="sectionHeading"><Title text="Activity" level="H3" /><Text text="Authoritative task and protocol milestones" /></VBox>
                <SegmentedButton selectedKey="{warehouse>/activityFilter}" selectionChange=".onActivityFilterChange" width="100%">
                  <items><SegmentedButtonItem key="ALL" text="All" /><SegmentedButtonItem key="TASK" text="Tasks" /><SegmentedButtonItem key="VDA" text="VDA" /><SegmentedButtonItem key="EXCEPTION" text="Errors" /></items>
                </SegmentedButton>
                <List items="{warehouse>/visibleInspectionActivity}" noDataText="No matching activity" showSeparators="None" class="activityFeed">
                  <CustomListItem>
                    <HBox class="activityItem" alignItems="Start">
                      <core:Icon src="{warehouse>icon}" color="{= ${warehouse>state} === 'Error' ? '#bb0000' : ${warehouse>state} === 'Success' ? '#188918' : '#0a6ed1' }" />
                      <VBox><HBox justifyContent="SpaceBetween"><Text text="{warehouse>title}" class="activityTitle" /><Text text="{warehouse>timeLabel}" class="activityTime" /></HBox><Text text="{warehouse>description}" wrapping="true" /></VBox>
                    </HBox>
                  </CustomListItem>
                </List>
              </VBox>
            </VBox>
          </ScrollContainer>
        </VBox>
      </HBox>

      <Toolbar class="activityStrip">
        <ObjectStatus text="LIVE" state="Success" inverted="true" />
        <Text text="{warehouse>/activityText}" />
        <ToolbarSpacer />
        <Text text="{= ${warehouse>/agv/velocity} + ' m/s · fork ' + ${warehouse>/agv/forkHeight} + ' m' }" />
      </Toolbar>
    </VBox>
  </Page>

  <Dialog id="vdaInspectorDialog" contentWidth="92vw" contentHeight="85vh" stretchOnPhone="true" draggable="true" resizable="true" class="vdaInspectorDialog">
    <customHeader>
      <OverflowToolbar class="vdaInspectorHeader">
        <core:Icon src="sap-icon://source-code" size="1.25rem" />
        <VBox><Title text="VDA 5050 workbench" level="H2" /><Text text="{= 'TO-' + ${warehouse>/selectedOrder/shortId} + ' · ' + ${warehouse>/inspection/selectedTask/label} }" /></VBox>
        <ToolbarSpacer />
        <ObjectStatus text="VDA 5050 v3.0.0" state="Success" icon="sap-icon://sys-enter-2" />
        <ObjectStatus text="{warehouse>/inspection/selectedDispatch/validityLabel}" state="{warehouse>/inspection/selectedDispatch/statusState}" inverted="true" />
        <Button icon="sap-icon://decline" tooltip="Close inspector" press=".onCloseVdaInspector" />
      </OverflowToolbar>
    </customHeader>
    <content>
      <HBox fitContainer="true" renderType="Bare" class="vdaWorkbench">
        <VBox width="19rem" renderType="Bare" class="vdaNavigator">
          <VBox class="vdaNavigatorHeader"><Text text="TASKS &amp; BASE UPDATES" class="sectionEyebrow" /><Title text="Message history" level="H3" /><Text text="Newest updates appear first" /></VBox>
          <List id="vdaNavigatorList" items="{warehouse>/inspection/navigatorItems}" itemPress=".onVdaNavigatorPress" showSeparators="None" class="vdaNavigatorList">
            <CustomListItem type="{= ${warehouse>enabled} ? 'Active' : 'Inactive' }" selected="{warehouse>selected}">
              <VBox visible="{= ${warehouse>kind} === 'TASK' }" class="vdaTaskGroup"><Title text="{warehouse>title}" level="H4" /><Text text="{warehouse>description}" /><ObjectStatus text="{warehouse>info}" state="{warehouse>infoState}" /></VBox>
              <HBox visible="{= ${warehouse>kind} === 'DISPATCH' }" justifyContent="SpaceBetween" alignItems="Center" class="vdaUpdateItem">
                <VBox><Title text="{warehouse>title}" level="H5" /><Text text="{warehouse>description}" /></VBox>
                <ObjectStatus text="{warehouse>info}" state="{warehouse>infoState}" />
              </HBox>
            </CustomListItem>
          </List>
        </VBox>

        <VBox renderType="Bare" class="vdaInspectorMain">
          <OverflowToolbar class="vdaInspectorToolbar">
            <SegmentedButton selectedKey="{warehouse>/vdaViewMode}" selectionChange=".onVdaViewModeChange">
              <items><SegmentedButtonItem key="STRUCTURED" text="Structured" icon="sap-icon://tree" /><SegmentedButtonItem key="RAW" text="Raw JSON" icon="sap-icon://syntax" /></items>
            </SegmentedButton>
            <ToolbarSeparator />
            <ObjectStatus title="Vehicle" text="{= ${warehouse>/inspection/selectedDispatch/manufacturer} + ' / ' + ${warehouse>/inspection/selectedDispatch/serialNumber} }" icon="sap-icon://shipping-status" />
            <ObjectStatus title="Lifecycle" text="{warehouse>/inspection/selectedDispatch/status}" state="Information" />
            <ToolbarSpacer />
            <Button text="Latest" icon="sap-icon://refresh" type="Transparent" press=".onJumpToLatestVda" enabled="{= !${warehouse>/inspection/followLatest} }" />
            <Button text="Copy" icon="sap-icon://copy" type="Transparent" press=".onCopyVdaJson" />
            <Button text="Download" icon="sap-icon://download" type="Transparent" press=".onDownloadVdaJson" />
          </OverflowToolbar>

          <ScrollContainer vertical="true" horizontal="false" height="100%" visible="{= ${warehouse>/vdaViewMode} === 'STRUCTURED' }" class="vdaStructuredScroll">
            <VBox class="vdaStructuredContent">
              <MessageStrip visible="{= !!${warehouse>/inspection/selectedDispatch/parseError} }" type="Error" showIcon="true"
                text="{= 'Payload could not be parsed: ' + ${warehouse>/inspection/selectedDispatch/parseError} }" />
              <MessageStrip visible="{= !!${warehouse>/inspection/selectedDispatch/validationError} || !!${warehouse>/inspection/selectedDispatch/rejectionError} }" type="Error" showIcon="true"
                text="{= ${warehouse>/inspection/selectedDispatch/rejectionError} || ${warehouse>/inspection/selectedDispatch/validationError} }" />

              <HBox wrap="Wrap" class="vdaSummaryGrid">
                <VBox><Label text="Order ID" /><Text text="{warehouse>/inspection/selectedDispatch/orderId}" wrapping="true" /></VBox>
                <VBox><Label text="Update" /><ObjectNumber number="{warehouse>/inspection/selectedDispatch/orderUpdateId}" unit="orderUpdateId" /></VBox>
                <VBox><Label text="Header ID" /><ObjectNumber number="{warehouse>/inspection/selectedDispatch/parsedPayload/headerId}" /></VBox>
                <VBox><Label text="Published" /><Text text="{warehouse>/inspection/selectedDispatch/timeLabel}" /></VBox>
              </HBox>

              <VBox class="baseHorizonCard">
                <HBox justifyContent="SpaceBetween" alignItems="Center"><VBox><Title text="Base release" level="H3" /><Text text="Released nodes may execute; horizon nodes remain planning information." /></VBox><ObjectNumber number="{warehouse>/inspection/selectedDispatch/releasedNodeCount}" unit="released" /></HBox>
                <ProgressIndicator percentValue="{warehouse>/inspection/selectedDispatch/releasedPercent}"
                  displayValue="{= ${warehouse>/inspection/selectedDispatch/releasedNodeCount} + ' base · ' + ${warehouse>/inspection/selectedDispatch/horizonNodeCount} + ' horizon' }" state="Information" />
              </VBox>

              <VBox visible="{warehouse>/inspection/selectedDispatch/hasDiff}" class="vdaDiffCard">
                <HBox alignItems="Center"><core:Icon src="sap-icon://compare" /><VBox><Title text="Changes from previous update" level="H4" /><Text text="Semantic changes only; timestamps and header noise are omitted." /></VBox></HBox>
                <List items="{warehouse>/inspection/selectedDispatch/diffItems}" showSeparators="None"><StandardListItem title="{warehouse>}" icon="sap-icon://add-activity" /></List>
              </VBox>

              <HBox justifyContent="SpaceBetween" alignItems="Center" class="sectionHeading"><VBox><Title text="Executable sequence" level="H3" /><Text text="Nodes and edges ordered by sequenceId" /></VBox><Text text="{= ${warehouse>/inspection/selectedDispatch/nodeCount} + ' nodes · ' + ${warehouse>/inspection/selectedDispatch/edgeCount} + ' edges' }" /></HBox>
              <List items="{warehouse>/inspection/selectedDispatch/sequence}" itemPress=".onVdaSequencePress" noDataText="No sequence elements in this payload" showSeparators="None" class="vdaSequenceList">
                <CustomListItem type="Active">
                  <HBox class="vdaSequenceItem" alignItems="Center">
                    <ObjectNumber number="{warehouse>sequenceId}" unit="seq" />
                    <ObjectStatus text="{warehouse>kind}" state="{= ${warehouse>kind} === 'NODE' ? 'Information' : 'None' }" inverted="true" />
                    <VBox><Title text="{warehouse>id}" level="H4" /><Text text="{warehouse>position}" /><Text text="{warehouse>actionSummary}" /></VBox>
                    <Text text="{warehouse>speed}" />
                    <ObjectStatus text="{warehouse>releaseLabel}" state="{= ${warehouse>released} ? 'Success' : 'Warning' }" icon="{= ${warehouse>released} ? 'sap-icon://unlocked' : 'sap-icon://pending' }" />
                  </HBox>
                </CustomListItem>
              </List>

              <VBox visible="{= !!${warehouse>/selectedVdaSequence} }" class="sequenceDetailCard">
                <Text text="SELECTED ELEMENT" class="sectionEyebrow" />
                <Title text="{= ${warehouse>/selectedVdaSequence/kind} + ' · ' + ${warehouse>/selectedVdaSequence/id} }" level="H4" />
                <Text text="{warehouse>/selectedVdaSequence/actionDetails}" wrapping="true" renderWhitespace="true" />
              </VBox>
            </VBox>
          </ScrollContainer>

          <VBox visible="{= ${warehouse>/vdaViewMode} === 'RAW' }" height="100%" class="vdaRawPane">
            <MessageStrip text="Exact schema-validated wire payload. This view is read-only." type="Information" showIcon="true" />
            <code:CodeEditor value="{warehouse>/inspection/selectedDispatch/rawJson}" type="json" editable="false" height="100%" class="vdaCodeEditor" />
          </VBox>
        </VBox>
      </HBox>
    </content>
  </Dialog>

  <Dialog id="seedDialog" showHeader="false" contentWidth="54rem" stretchOnPhone="true" class="seedDialog">
    <VBox class="seedContent">
      <ObjectStatus text="VDA 5050 v3.0.0 DEMO" state="Information" icon="sap-icon://connected" />
      <Title text="Choose today’s warehouse story" level="H1" />
      <Text text="We’ll prepare inventory, fleet state, and representative transport orders. Work starts automatically." />
      <HBox wrap="Wrap" class="scenarioTiles">
        <GenericTile header="Balanced shift" subheader="Inbound and outbound share one vehicle" press=".onStartBalanced" class="scenarioTile">
          <tileContent><TileContent footer="32 stored · 4 inbound"><content><NumericContent value="2" scale="orders" icon="sap-icon://process" /></content></TileContent></tileContent>
        </GenericTile>
        <GenericTile header="Inbound surge" subheader="Clear a busy staging lane" press=".onStartInbound" class="scenarioTile recommendedTile">
          <tileContent><TileContent footer="12 inbound · High priority"><content><NumericContent value="6" scale="loads" icon="sap-icon://inbox" valueColor="Good" /></content></TileContent></tileContent>
        </GenericTile>
        <GenericTile header="Outbound wave" subheader="Fulfil a priority shipment" press=".onStartOutbound" class="scenarioTile">
          <tileContent><TileContent footer="40 stored · Urgent"><content><NumericContent value="6" scale="loads" icon="sap-icon://shipping-status" valueColor="Critical" /></content></TileContent></tileContent>
        </GenericTile>
      </HBox>
      <MessageStrip text="Reload keeps the selected scenario. Reset returns to this dialogue." type="Information" showIcon="true" />
    </VBox>
  </Dialog>

  <Dialog id="transportOrderDialog" title="New transport order" contentWidth="36rem" stretchOnPhone="true">
    <VBox class="dialogForm">
      <Label text="Order type" labelFor="orderType" />
      <SegmentedButton id="orderType" selectedKey="{warehouse>/orderType}" selectionChange=".onOrderTypeChange" width="100%">
        <items><SegmentedButtonItem key="PUTAWAY" text="Put-away" icon="sap-icon://inbox" /><SegmentedButtonItem key="OUTBOUND" text="Outbound" icon="sap-icon://shipping-status" /></items>
      </SegmentedButton>
      <Label text="Eligible loads" labelFor="transportOrderLoads" />
      <MultiComboBox id="transportOrderLoads" width="100%" items="{warehouse>/eligibleLoads}">
        <core:Item key="{warehouse>id}" text="{= ${warehouse>id} + ' · ' + ${warehouse>item} + ' · ' + ${warehouse>locationId} }" />
      </MultiComboBox>
      <Label text="Operational priority" labelFor="orderPriority" />
      <Select id="orderPriority" selectedKey="{warehouse>/orderPriority}" width="100%">
        <items><core:Item key="NORMAL" text="Normal" /><core:Item key="HIGH" text="High" /><core:Item key="URGENT" text="Urgent" /></items>
      </Select>
      <Label text="Business objective" labelFor="orderObjective" />
      <TextArea id="orderObjective" value="{warehouse>/orderObjective}" rows="3" width="100%" />
      <MessageStrip text="The control tower will validate, plan, assign, and dispatch automatically. Priority affects fleet scheduling, not the VDA payload." type="Information" showIcon="true" />
    </VBox>
    <beginButton><Button text="Create and dispatch" type="Emphasized" press=".onCreateTransportOrder" /></beginButton>
    <endButton><Button text="Cancel" press=".onCloseTransportOrder" /></endButton>
  </Dialog>

  <Dialog id="receiveDialog" title="Receive inventory" contentWidth="28rem" stretchOnPhone="true">
    <VBox class="dialogForm">
      <Label text="Material / SKU" labelFor="receiveSku" /><Input id="receiveSku" value="{warehouse>/receiveSku}" />
      <Label text="Quantity" labelFor="receiveQuantity" /><StepInput id="receiveQuantity" value="{warehouse>/receiveQuantity}" min="1" max="50" width="100%" />
      <MessageStrip text="Received loads enter INBOUND-01 and become eligible for a put-away transport order." type="Information" showIcon="true" />
    </VBox>
    <beginButton><Button text="Receive inventory" type="Emphasized" press=".onReceiveFromDialog" /></beginButton>
    <endButton><Button text="Cancel" press=".onCloseReceive" /></endButton>
  </Dialog>
</mvc:View>
