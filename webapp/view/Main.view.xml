<mvc:View controllerName="warehouse.visualizer.controller.Main" displayBlock="true"
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:warehouse="warehouse.visualizer.control" xmlns:code="sap.ui.codeeditor">
  <Page showHeader="false" enableScrolling="false" class="warehousePage controlTowerPage">
    <VBox height="100%" renderType="Bare">
      <core:Fragment fragmentName="warehouse.visualizer.view.fragments.Header" type="XML" />

      <HBox fitContainer="true" renderType="Bare" class="towerWorkspace">
        <core:Fragment fragmentName="warehouse.visualizer.view.fragments.OrderRail" type="XML" />

        <core:Fragment fragmentName="warehouse.visualizer.view.fragments.WarehouseStage" type="XML" />

        <core:Fragment fragmentName="warehouse.visualizer.view.fragments.ExecutionPanel" type="XML" />
      </HBox>

      <core:Fragment fragmentName="warehouse.visualizer.view.fragments.StoryBar" type="XML" />
    </VBox>
  </Page>

  <core:Fragment fragmentName="warehouse.visualizer.view.fragments.dialogs.VdaInspectorDialog" type="XML" />

  <core:Fragment fragmentName="warehouse.visualizer.view.fragments.dialogs.HowItWorksDialog" type="XML" />

  <core:Fragment fragmentName="warehouse.visualizer.view.fragments.dialogs.ScenarioDialog" type="XML" />
  <core:Fragment fragmentName="warehouse.visualizer.view.fragments.dialogs.TransportOrderDialog" type="XML" />

  <core:Fragment fragmentName="warehouse.visualizer.view.fragments.dialogs.ReceiveInventoryDialog" type="XML" />
</mvc:View>
