<mvc:View controllerName="warehouse.visualizer.controller.Main" displayBlock="true"
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:mvc="sap.ui.core.mvc" xmlns:warehouse="warehouse.visualizer.control">
  <Page showHeader="false" enableScrolling="false" class="warehousePage">
    <l:Splitter orientation="Horizontal" height="100%" width="100%">
      <VBox class="warehousePanel" renderType="Bare">
        <layoutData><l:SplitterLayoutData size="23rem" minSize="336" resizable="true" /></layoutData>
        <VBox class="warehousePanelHeader">
          <Title text="{i18n>appTitle}" level="H1" />
          <Text text="{warehouse>/warehouseName}" />
          <HBox justifyContent="SpaceBetween" alignItems="Center" class="connectionRow">
            <ObjectStatus title="{i18n>backend}" text="{warehouse>/connectionStatus}" state="{= ${warehouse>/connectionStatus} === 'CONNECTED' ? 'Success' : 'Warning' }" />
            <SegmentedButton id="modeSelector" selectedKey="{warehouse>/mode}" selectionChange=".onModeChange">
              <items><SegmentedButtonItem key="LIVE" text="{i18n>live}" /><SegmentedButtonItem key="SANDBOX" text="{i18n>sandbox}" /></items>
            </SegmentedButton>
          </HBox>
          <HBox class="operationButtons" wrap="Wrap">
            <Button text="{= ${warehouse>/operationState} === 'PAUSED' ? ${i18n>resumeOperations} : ${i18n>stopOperations} }"
              icon="{= ${warehouse>/operationState} === 'PAUSED' ? 'sap-icon://media-play' : 'sap-icon://media-pause' }" press=".onToggleOperations" />
            <Button text="{i18n>resetSimulation}" icon="sap-icon://refresh" type="Negative" press=".onResetSimulation" />
          </HBox>
        </VBox>
        <VBox class="warehouseDetails" renderType="Bare">
          <Panel headerText="{i18n>inboundStaging}" expandable="true" expanded="true" visible="{= ${warehouse>/mode} === 'LIVE' }">
            <VBox class="workflowBox">
              <Label text="{i18n>sku}" labelFor="receiveSku" />
              <Input id="receiveSku" value="{warehouse>/receiveSku}" />
              <Label text="{i18n>quantity}" labelFor="receiveQuantity" />
              <StepInput id="receiveQuantity" value="{warehouse>/receiveQuantity}" min="1" max="50" step="1" width="100%" />
              <Button text="{i18n>receiveBoxes}" icon="sap-icon://add-product" type="Emphasized" press=".onReceive"
                enabled="{= ${warehouse>/operationState} === 'RUNNING' }" />
            </VBox>
          </Panel>
          <Panel headerText="{i18n>putaway}" expandable="true" expanded="true" visible="{= ${warehouse>/mode} === 'LIVE' }">
            <VBox class="workflowBox">
              <Label text="{i18n>incomingPallets}" labelFor="inboundLoads" />
              <MultiComboBox id="inboundLoads" width="100%" items="{warehouse>/inboundLoads}">
                <core:Item key="{warehouse>id}" text="{= ${warehouse>id} + ' / ' + ${warehouse>item} }" />
              </MultiComboBox>
              <Label text="{i18n>operatorPrompt}" labelFor="operatorPrompt" />
              <TextArea id="operatorPrompt" value="{warehouse>/operatorPrompt}" rows="3" width="100%" />
              <Button text="{i18n>storePallets}" icon="sap-icon://ai" type="Emphasized" press=".onPutaway" enabled="{= ${warehouse>/planningStatus} !== 'PLANNING' &amp;&amp; ${warehouse>/operationState} === 'RUNNING' }" />
              <ObjectStatus title="{i18n>planning}" text="{warehouse>/planningMessage}" state="{= ${warehouse>/planningStatus} === 'REJECTED' ? 'Error' : ${warehouse>/planningStatus} === 'VALIDATED' ? 'Success' : 'Information' }" />
            </VBox>
          </Panel>
          <Panel headerText="{i18n>outboundShipping}" expandable="true" expanded="true" visible="{= ${warehouse>/mode} === 'LIVE' }">
            <VBox class="workflowBox">
              <Label text="{i18n>storedBoxes}" labelFor="outboundLoads" />
              <MultiComboBox id="outboundLoads" width="100%" items="{warehouse>/storedLoads}">
                <core:Item key="{warehouse>id}" text="{= ${warehouse>id} + ' / ' + ${warehouse>item} + ' / ' + ${warehouse>locationId} }" />
              </MultiComboBox>
              <Button text="{i18n>shipSelected}" icon="sap-icon://shipping-status" type="Emphasized" press=".onOutbound"
                enabled="{= ${warehouse>/operationState} === 'RUNNING' }" />
            </VBox>
          </Panel>
          <Panel headerText="{i18n>agvStatus}" expandable="true" expanded="true">
            <VBox class="statusGrid">
              <ObjectStatus title="Vehicle" text="{warehouse>/agv/id}" icon="sap-icon://shipping-status" />
              <ObjectStatus title="Status" text="{warehouse>/agv/status}" state="{= ${warehouse>/agv/status} === 'MOVING' ? 'Information' : 'Success' }" />
              <ProgressIndicator percentValue="{warehouse>/agv/battery}" displayValue="{= ${warehouse>/agv/battery} + '%' }" state="Success" />
              <Text text="{= 'X ' + ${warehouse>/agv/x} + ' / Z ' + ${warehouse>/agv/z} }" />
            </VBox>
          </Panel>
          <Panel headerText="{i18n>jobs}" expandable="true" expanded="true">
            <List items="{warehouse>/jobs}" noDataText="{i18n>noJobs}">
              <ObjectListItem title="{warehouse>loadId}" number="{warehouse>sequence}" numberUnit="#" intro="{= ${warehouse>source} + ' to ' + ${warehouse>destination} }">
                <firstStatus><ObjectStatus text="{warehouse>status}" state="{= ${warehouse>status} === 'COMPLETED' ? 'Success' : ${warehouse>status} === 'FAILED' ? 'Error' : 'Information' }" /></firstStatus>
              </ObjectListItem>
            </List>
          </Panel>
          <Panel headerText="{i18n>inventory}" expandable="true" expanded="false">
            <List items="{warehouse>/liveInventory}"><StandardListItem title="{warehouse>item}" description="{= ${warehouse>id} + ' / ' + ${warehouse>locationId} }" info="{warehouse>status}" /></List>
          </Panel>
          <VBox visible="{= ${warehouse>/mode} === 'SANDBOX' }" class="sandboxNotice">
            <MessageStrip text="{i18n>sandboxNotice}" type="Warning" showIcon="true" />
            <Button text="{i18n>moveForklift}" press=".onMoveForklift" />
          </VBox>
        </VBox>
      </VBox>
      <VBox class="viewportColumn" renderType="Bare">
        <layoutData><l:SplitterLayoutData size="auto" minSize="480" /></layoutData>
        <warehouse:WarehouseViewport id="viewport" rackSelected=".onRackSelected" class="warehouseViewport" />
        <Text text="{= ${warehouse>/mode} === 'SANDBOX' ? ${i18n>sceneHintSandbox} : ${i18n>sceneHintLive} }" class="sceneHint" />
      </VBox>
    </l:Splitter>
  </Page>
</mvc:View>
