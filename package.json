{
  "name": "@aipoweredapps/warehouse-visualizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bundle:babylon": "node scripts/build-babylon.mjs",
    "prestart": "npm run bundle:babylon",
    "start": "ui5 serve --port 8080 --open index.html",
    "prebuild": "npm run bundle:babylon",
    "build": "ui5 build --clean-dest --include-all-dependencies --include-task generateVersionInfo --exclude-task generateComponentPreload",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:e2e",
    "test:unit": "ui5 serve --port 8081",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "audit:toolchain": "npm audit"
  },
  "dependencies": {
    "@babylonjs/core": "^9.21.2"
  },
  "devDependencies": {
    "@openui5/sap.m": "^1.151.0",
    "@openui5/sap.ui.codeeditor": "^1.151.0",
    "@openui5/sap.ui.core": "^1.151.0",
    "@openui5/sap.ui.layout": "^1.151.0",
    "@openui5/themelib_sap_horizon": "^1.151.0",
    "@openui5/types": "^1.151.0",
    "@playwright/test": "^1.62.1",
    "@types/qunit": "^2.19.12",
    "@ui5/cli": "^4.0.62",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2",
    "ui5-tooling-modules": "^3.30.0",
    "ui5-tooling-transpile": "^3.6.0"
  }
}
